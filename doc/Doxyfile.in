PROJECT_NAME           = @CMAKE_PROJECT_NAME@
PROJECT_NUMBER         = @VERSION@
PROJECT_BRIEF          = "Cross-platform music production software"

# TODO 5166: Update these paths
PROJECT_LOGO           = @CMAKE_SOURCE_DIR@/../cmake/linux/icons/scalable/apps/mxm.svg
PROJECT_ICON           = @CMAKE_SOURCE_DIR@/../cmake/linux/icons/scalable/apps/mxm.svg

OUTPUT_DIRECTORY       = doc/
STRIP_FROM_PATH        = ../
TIMESTAMP              = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
CASE_SENSE_NAMES       = NO
SORT_MEMBERS_CTORS_1ST = YES
QUIET                  = YES
INPUT                  = @CMAKE_SOURCE_DIR@/../README.md \
                         @CMAKE_SOURCE_DIR@/../src \
                         @CMAKE_SOURCE_DIR@/../include \
                         @CMAKE_SOURCE_DIR@/../plugins
FILE_PATTERNS          = *.c \
                         *.cc \
                         *.cxx \
                         *.cxxm \
                         *.cpp \
                         *.cppm \
                         *.ccm \
                         *.h \
                         *.hh \
                         *.hxx \
                         *.hpp
RECURSIVE              = YES
EXCLUDE                = @CMAKE_SOURCE_DIR@/../src/3rdparty \
                         @CMAKE_SOURCE_DIR@/../plugins/CarlaBase/carla \
                         @CMAKE_SOURCE_DIR@/../plugins/FreeBoy/game-music-emu \
                         @CMAKE_SOURCE_DIR@/../plugins/LadspaEffect/calf/veal \
                         @CMAKE_SOURCE_DIR@/../plugins/LadspaEffect/caps \
                         @CMAKE_SOURCE_DIR@/../plugins/LadspaEffect/cmt/cmt \
                         @CMAKE_SOURCE_DIR@/../plugins/LadspaEffect/swh/ladspa \
                         @CMAKE_SOURCE_DIR@/../plugins/LadspaEffect/tap/tap-plugins \
                         @CMAKE_SOURCE_DIR@/../plugins/OpulenZ/adplug \
                         @CMAKE_SOURCE_DIR@/../plugins/Sid/resid/resid \
                         @CMAKE_SOURCE_DIR@/../plugins/Xpressive/exprtk \
                         @CMAKE_SOURCE_DIR@/../plugins/ZynAddSubFx/zynaddsubfx
USE_MDFILE_AS_MAINPAGE = @CMAKE_SOURCE_DIR@/../README.md
GENERATE_TREEVIEW      = NO
HTML_EXTRA_STYLESHEET  = @CMAKE_SOURCE_DIR@/extra.css
USE_MATHJAX            = YES
GENERATE_LATEX         = NO
PREDEFINED             = MXM_BUILD_LINUX= \
                         MXM_HOST_X86_64= \
                         MXM_HAVE_ALSA= \
                         MXM_HAVE_FLUIDSYNTH= \
                         MXM_HAVE_JACK= \
                         MXM_HAVE_JACK_PRENAME= \
                         MXM_HAVE_WEAKJACK= \
                         MXM_HAVE_LV2= \
                         MXM_HAVE_SUIL= \
                         MXM_HAVE_MP3LAME= \
                         MXM_HAVE_SNDFILE_MP3= \
                         MXM_HAVE_OGGVORBIS= \
                         MXM_HAVE_SNDIO= \
                         MXM_HAVE_PORTAUDIO= \
                         MXM_HAVE_PULSEAUDIO= \
                         MXM_HAVE_SDL= \
                         MXM_HAVE_STK= \
                         MXM_HAVE_VST= \
                         MXM_HAVE_VST_32= \
                         MXM_HAVE_VST_64= \
                         MXM_HAVE_SF_COMPLEVEL= \
                         MXM_DEBUG_FPE= \
                         MXM_HAVE_PTHREAD_H= \
                         MXM_HAVE_UNISTD_H= \
                         MXM_HAVE_SYS_IPC_H= \
                         MXM_HAVE_SEMAPHORE_H= \
                         MXM_HAVE_SYS_TIMES_H= \
                         MXM_HAVE_SYS_PRCTL_H= \
                         MXM_HAVE_SCHED_H= \
                         MXM_HAVE_SYS_SOUNDCARD_H= \
                         MXM_HAVE_SOUNDCARD_H= \
                         MXM_HAVE_FCNTL_H= \
                         MXM_HAVE_SYS_IOCTL_H= \
                         MXM_HAVE_PROCESS_H=
